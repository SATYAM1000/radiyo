# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Root domain for the platform. Tenant sites live at {slug}.{ROOT_DOMAIN}.
# Local dev: lvh.me:3000 (resolves to 127.0.0.1). Production: rediyo.in
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# Mixpanel project token (public, client-side analytics)
NEXT_PUBLIC_MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN
